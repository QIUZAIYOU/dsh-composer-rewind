{
  "name": "dsh-prompt-vault",
  "version": "1.1.1",
  "type": "module",
  "description": "Composer input history for the DeepSeek Harness Web UI: records prompts, attachments, command tokens and the active DSH setup, then restores the whole composer state.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt-history",
    "composer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIUZAIYOU/dsh-prompt-vault.git"
  },
  "homepage": "https://github.com/QIUZAIYOU/dsh-prompt-vault#readme",
  "bugs": {
    "url": "https://github.com/QIUZAIYOU/dsh-prompt-vault/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": ["@deepseek-ai/dsh-client-ui-primitives"],
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
