{
  "name": "dsh-composer-rewind",
  "version": "2.0.3",
  "type": "module",
  "description": "Composer input history for the DeepSeek Harness Web UI: records composer contents, attachments, command tokens and the active DSH setup, then restores the whole composer state.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "composer-history",
    "composer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIUZAIYOU/dsh-composer-rewind.git"
  },
  "homepage": "https://github.com/QIUZAIYOU/dsh-composer-rewind#readme",
  "bugs": {
    "url": "https://github.com/QIUZAIYOU/dsh-composer-rewind/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
